{% liquid
  assign hero_alt = section.settings.image.alt | default: section.settings.heading
  assign button_url = section.settings.button_collection.url | default: routes.all_products_collection_url
%}

<section
  id="AssignmentHero-{{ section.id }}"
  class="assignment-hero"
>
  <div class="assignment-hero-media">

    {% if section.settings.image != blank %}
      {{
        section.settings.image
        | image_url: width: 2400
        | image_tag:
          loading: 'eager',
          widths: '750, 1100, 1500, 1800, 2200, 2400',
          sizes: '100vw',
          class: 'assignment-hero-image',
          alt: hero_alt
      }}
    {% endif %}

    <div class="assignment-hero-content">

      {% if section.settings.heading != blank %}
        <img
          src="{{ 'spring-break.png' | asset_url }}"
          alt="{{ section.settings.heading | escape }}"
          class="assignment-hero-lockup"
          width="390"
          height="108"
          loading="eager"
        >
      {% endif %}

      {% if section.settings.button_label != blank %}
        <a
          href="{{ button_url }}"
          class="assignment-hero-button"
        >
          {{ section.settings.button_label | escape }}
        </a>
      {% endif %}

    </div>

    {% if section.settings.show_reviews %}
      <a
        href="#reviews"
        class="assignment-hero-reviews"
        aria-label="Reviews"
      >
        <span>REVIEWS</span>
      </a>
    {% endif %}

  </div>
</section>

<style>
  #AssignmentHero-{{ section.id }} {
    width: 100%;
    margin: 0;
    padding: 0;
  }

  #AssignmentHero-{{ section.id }} .assignment-hero-media {
    position: relative;
    width: 100%;
    aspect-ratio: 1440 / 810;
    overflow: hidden;
    background: #d9d9d9;
  }

  #AssignmentHero-{{ section.id }} .assignment-hero-image {
    position: absolute;
    inset: 0;
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center center;
  }

  #AssignmentHero-{{ section.id }} .assignment-hero-content {
    position: absolute;
    z-index: 2;
    top: 50%;
    left: 50%;
    display: flex;
    flex-direction: column;
    align-items: center;
    transform: translate(-50%, -50%);
  }

  #AssignmentHero-{{ section.id }} .assignment-hero-lockup {
    display: block;
    width: min(390px, 32vw);
    height: auto;
    margin: 0 0 18px;
  }

  #AssignmentHero-{{ section.id }} .assignment-hero-button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 253px;
    height: 48px;
    padding: 0 24px;
    border: 0;
    border-radius: 0;
    background: #d9f8fa;
    color: #011f13;
    text-decoration: none;
    font-family: Arial, Helvetica, sans-serif;
    font-size: 11px;
    font-weight: 600;
    line-height: 1;
    letter-spacing: 0;
    text-transform: uppercase;
    transition:
      background-color 180ms ease,
      color 180ms ease,
      opacity 180ms ease;
  }

  #AssignmentHero-{{ section.id }} .assignment-hero-button:hover {
    background: #c7eff1;
  }

  #AssignmentHero-{{ section.id }} .assignment-hero-button:focus-visible {
    outline: 2px solid #011f13;
    outline-offset: 4px;
  }

  #AssignmentHero-{{ section.id }} .assignment-hero-reviews {
    position: absolute;
    z-index: 3;
    top: 50%;
    right: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 28px;
    height: 89px;
    border: 0.3px solid rgba(1, 31, 19, 0.45);
    border-right: 0;
    border-radius: 14px 0 0 14px;
    background: #ffffff;
    color: #011f13;
    text-decoration: none;
    transform: translateY(-50%);
  }

  #AssignmentHero-{{ section.id }} .assignment-hero-reviews span {
    display: block;
    font-family: Arial, Helvetica, sans-serif;
    font-size: 9px;
    font-weight: 600;
    line-height: 1;
    letter-spacing: 0.02em;
    writing-mode: vertical-rl;
    transform: rotate(180deg);
  }

  #AssignmentHero-{{ section.id }} .assignment-hero-reviews:focus-visible {
    outline: 2px solid #011f13;
    outline-offset: -4px;
  }

  @media screen and (max-width: 749px) {
    #AssignmentHero-{{ section.id }} .assignment-hero-media {
      aspect-ratio: 4 / 5;
    }

    #AssignmentHero-{{ section.id }} .assignment-hero-lockup {
      width: min(300px, 72vw);
      margin-bottom: 14px;
    }

    #AssignmentHero-{{ section.id }} .assignment-hero-button {
      width: 190px;
      height: 44px;
      font-size: 10px;
    }

    #AssignmentHero-{{ section.id }} .assignment-hero-reviews {
      width: 26px;
      height: 78px;
      border-radius: 13px 0 0 13px;
    }

    #AssignmentHero-{{ section.id }} .assignment-hero-reviews span {
      font-size: 8px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    #AssignmentHero-{{ section.id }} .assignment-hero-button {
      transition: none;
    }
  }
</style>

{% schema %}
{
  "name": "Assignment Hero",
  "tag": "section",
  "class": "section-assignment-hero",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Hero image"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Headline",
      "default": "Spring Break"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Shop the Collection"
    },
    {
      "type": "collection",
      "id": "button_collection",
      "label": "Button collection"
    },
    {
      "type": "checkbox",
      "id": "show_reviews",
      "label": "Show Reviews tab",
      "default": true
    }
  ],
  "presets": [
    {
      "name": "Assignment Hero"
    }
  ]
}
{% endschema %}